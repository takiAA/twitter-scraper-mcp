{
  "name": "twitter-mcp-server",
  "version": "1.1.0",
  "private": true,
  "description": "Session-based X research tools over MCP, powered by twscrape, with public post lookup.",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs && npm run test:python",
    "test:client": "node test-mcp-client.js",
    "test:live": "npm run build && node test-mcp-client.js --tweet 1897009050392379653",
    "docker:build": "docker compose build",
    "docker:run": "docker compose run --rm -T twitter-scraper-mcp",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:twscrape": "node scripts/python.js setup",
    "auth:import": "node scripts/python.js import",
    "test:python": "node scripts/python.js test",
    "test:session": "npm run build && node scripts/live-session-smoke.mjs",
    "auth:browser": "node scripts/auth-browser.js",
    "publication:check": "node scripts/publication-check.js",
    "security:scan": "gitleaks git --redact=100 --no-banner --config .gitleaks.toml --log-opts=--all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^16.4.7",
    "htmlparser2": "^12.0.0",
    "https-proxy-agent": "^7.0.6",
    "twitter-api-v2": "^1.29.1",
    "undici": "^7.29.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@steipete/sweet-cookie": "0.4.4",
    "@types/node": "^22.13.9",
    "nock": "^14.0.17",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takiAA/twitter-scraper-mcp.git"
  },
  "homepage": "https://github.com/takiAA/twitter-scraper-mcp#readme",
  "bugs": {
    "url": "https://github.com/takiAA/twitter-scraper-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "twitter",
    "x",
    "twscrape"
  ],
  "files": [
    "dist",
    "python/worker.py",
    "python/session_writer.py",
    "scripts/import-session.py",
    "requirements.txt",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "DISCLAIMER.md"
  ]
}
