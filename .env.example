# Public single-post reads need no credentials or Python.
TWITTER_READ_BACKEND=oembed
# Search and user timelines use your local X session by default.
TWITTER_DISCOVERY_BACKEND=twscrape
# Writes are independent of read backends and stay disabled by default.
TWITTER_ENABLE_WRITE=false
TWITTER_WRITE_BACKEND=api
# Session writes require an exact local account label from auth:import.
# Set TWITTER_WRITE_BACKEND=session to use it; no developer API keys needed.
TWITTER_WRITE_ACCOUNT=
REQUEST_TIMEOUT_MS=20000

# Local session database, relative to the project root or an absolute path.
TWSCRAPE_ACCOUNTS_DB=.local/accounts.db
# Empty: use project .venv, then python3. Docker sets its own Python path.
TWSCRAPE_PYTHON=
TWSCRAPE_HTTP_BACKEND=httpx

# Optional HTTP(S) proxy, with TLS verification enabled.
# Local: http://127.0.0.1:7890 ; Docker: http://host.docker.internal:7890
PROXY_URL=

# Official API is opt-in and may incur charges.
# TWITTER_READ_BACKEND=api affects getTweet only.
# TWITTER_DISCOVERY_BACKEND=api affects searchTweets/getUserTweets only.
TWITTER_BEARER_TOKEN=
# Required only for official API writes. Session writes use a separate adapter.
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# No username/password/2FA automation. Import cookies with npm run auth:import.
